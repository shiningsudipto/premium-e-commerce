# Express API (premium-ec-backend)
API_URL=http://localhost:4000
# This storefront's public origin; used for CSRF origin checks, metadata and sitemaps
SITE_URL=http://localhost:3000
# Shared with the backend's REVALIDATE_SECRET; the worker calls /api/revalidate with it
REVALIDATE_SECRET=change-me-to-a-long-random-string
# Used when no market prefix, cookie or geo match applies: {locale}-{market handle}
DEFAULT_MARKET=en-bd
# Sales channel handle sent as x-channel
CHANNEL=web
